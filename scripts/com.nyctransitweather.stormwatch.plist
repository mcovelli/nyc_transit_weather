<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nyctransitweather.stormwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mike/nyc_transit_weather/scripts/run_pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mike/nyc_transit_weather</string>

    <!-- Temporary elevated-frequency check while the Nor'easter is active.
         Runs immediately, then every 30 minutes. Unload this when the storm passes -
         the regular twice-daily com.nyctransitweather.pipeline job stays untouched. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/mike/nyc_transit_weather/pipeline_stormwatch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mike/nyc_transit_weather/pipeline_stormwatch.log</string>
</dict>
</plist>
