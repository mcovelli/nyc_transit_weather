<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nyctransitweather.stormwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mike/nyc_transit_weather/scripts/run_pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mike/nyc_transit_weather</string>

    <!-- Temporary elevated-frequency check while the Nor'easter is active.
         Runs immediately, then at :00 and :30 of every hour. Unload this when the
         storm passes - the regular twice-daily com.nyctransitweather.pipeline job
         stays untouched.
         Uses StartCalendarInterval rather than StartInterval: StartInterval proved
         unreliable in practice (didn't refire for 50+ minutes despite being
         correctly registered - likely macOS power-management throttling of timer-
         based LaunchAgents), whereas StartCalendarInterval is what the main
         twice-daily job uses and it fired reliably 40/40 times over 20 days. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/mike/nyc_transit_weather/pipeline_stormwatch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mike/nyc_transit_weather/pipeline_stormwatch.log</string>
</dict>
</plist>
